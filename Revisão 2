import java.util.Scanner;

public class Caixa {
    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);
        double saldo = 500.00;
        int opcoes;

        do {
            System.out.println("<><><> CAIXA ELETRÔNICO <><><>");
            System.out.println("1- Consultar saldo");
            System.out.println("2- Realizar depósito");
            System.out.println("3- Realizar saque");
            System.out.println("4- Sair");
            System.out.print("Digite a opção desejada: ");

            opcoes = scanner.nextInt();

            switch (opcoes) {
                case 1:
                    System.out.printf("O seu saldo atual é de: R$ %.2f\n", saldo);
                break;

                case 2:
                    System.out.printf("Digite o valor desejado para o depósito: R$ ");
                    double deposito = scanner.nextDouble();

                    if (deposito > 0) {
                        saldo += deposito;
                        System.out.println("Depósito concluído!");
                    }
                    else {
                        System.out.println("Erro: não é possível realizar um depósito com valor igual ou menor que zero.");
                    }
                    break;
                
                case 3:
                    System.out.print("Digite o valor desejado para o saque: R$ ");
                    double saque = scanner.nextDouble();

                    if (saque <=0){
                        System.out.println("Erro: o valor desejado para o saque deve ser maior do que zero.");
                    }
                    else if (saque > saldo) {
                        System.out.println("Erro: não é possível sacar um valor maior que o saldo disponível.");
                    }
                    else {
                        saldo -= saque;
                        System.out.println("Saque realizado!");
                    }
                    break;

                case 4:
                    System.out.print("Operação encerrada.");
                    break;

                default:
                    System.out.println("Opção inválida. Por favor, digite uma das opções listadas acima.");
                    break;
            }
        }
        while (opcoes != 4);

        scanner.close();
    
    }
}
