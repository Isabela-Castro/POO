import java.util.Scanner;

public class Tabuada {
    public static void main(String[] args) {
    Scanner scanner = new Scanner(System.in);
    int numero;

    while (true) {
        System.out.print("Digite um número inteiro e positivo para iniciar ou digite 0 para finalizar a tabuada: ");
        numero = scanner.nextInt();

        if (numero == 0) {
            System.out.println("Tabuada finalizada.");
            break;
        }
        
        else if (numero < 0) {
            System.out.println("Número inválido. Por favor, digite um número maior que 0.");
        }

        else {
            for (int i = 1; i <= 10; i++) {
            int resultado = numero * i;

    String tipo;

        if (resultado % 2 == 0) {
            tipo = "par.";
        } else {
            tipo = "ímpar.";
        }
        System.out.println(numero + "x" + i + "=" + resultado + " que é um número " + tipo);
        }
        }

        }
    scanner.close();

    }

}
